{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@argos/core": ["./packages/core/src"],
      "@argos/monitor": ["./packages/monitor/src"],
      "@argos/aggregator": ["./packages/aggregator/src"],
      "@argos/tor": ["./packages/tor/src"],
      "@argos/graph": ["./packages/graph/src"],
      "@argos/video": ["./packages/video/src"],
      "@argos/payments": ["./packages/payments/src"],
      "@argos/ollama": ["./packages/ollama/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", ".turbo"]
}
