# ─── ARGOS .env.example ─────────────────────────────
# انسخ هذا الملف إلى .env :  cp .env.example .env

# ─── Ollama (local-first LLM) ───
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=falcon-h1-ar
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Neo4j (GraphRAG) ───
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=argos-local-dev

# ─── Postgres (primary store) ───
DATABASE_URL=postgres://argos:argos-local-dev@localhost:5432/argos

# ─── Redis (BullMQ) ───
REDIS_URL=redis://localhost:6379

# ─── Crypto / Base L2 ───
BASE_RPC_URL=https://mainnet.base.org
BASE_CHAIN_ID=8453
ARGOS_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Paylix (crypto payments) ───
PAYLIX_API_KEY=paylix_test_key_replace_me
PAYLIX_WEBHOOK_SECRET=whsec_replace_me
PAYLIX_ENV=sandbox

# ─── API ───
API_PORT=8787
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ─── WorldMonitor MCP ───
WORLDMONITOR_MCP_URL=http://localhost:3100/mcp
WORLDMONITOR_API_KEY=
WORLDMONITOR_TIMEOUT_MS=15000

# ─── Tor / I2P (Phase 4 — optional) ───
TOR_SOCKS_PROXY=socks5h://127.0.0.1:9050
I2P_HTTP_PROXY=http://127.0.0.1:4444
